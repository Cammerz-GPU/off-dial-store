# App
PORT=3000
SITE_URL=http://localhost:3000

# Stripe — add these after creating your Stripe account
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PostgreSQL — works with Neon, Supabase, Railway, Render, etc.
DATABASE_URL=

# Admin page (/admin)
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-to-a-long-random-password

# Order emails (optional until you're ready)
RESEND_API_KEY=
EMAIL_FROM=Off Dial Watches <orders@yourdomain.com>
ADMIN_EMAIL=

# Comma-separated ISO country codes that Stripe may accept for shipping.
# Edit this list before launch if you want to restrict destinations.
SHIPPING_COUNTRIES=GB,US,CA,AU,NZ,IE,FR,DE,ES,IT,NL,BE,PT,AT,CH,SE,NO,DK,FI,PL,CZ,JP,SG,HK,AE
